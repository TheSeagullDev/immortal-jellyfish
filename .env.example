# From Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Gemini (AI Studio) — used to tag plates against today's Nutrislice menu
# GEMINI_API_KEY=your-gemini-api-key

# Resend — demo "this is incorrect" reports emailed to an admin
# RESEND_API_KEY=re_xxxxxxxxx
# REPORT_EMAIL=you@example.com
# RESEND_FROM=MealWise <onboarding@resend.dev>

# Optional: only needed for admin scripts / migrations via service role
# Never expose this to the browser
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
